APP_ENV=development

# 文件上传配置
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_TYPES=image/*,.pdf,.zip,.doc,.docx

# 对象存储配置（预留）
OSS_ENDPOINT=
OSS_BUCKET=
