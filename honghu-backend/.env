DATABASE_URL="postgresql://yululiu@localhost:5432/honghu?schema=public"
# Redis 配置（预留）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Swagger 配置
SWAGGER_TITLE=梧桐·鸿鹄大赛平台 API
SWAGGER_DESCRIPTION=梧桐·鸿鹄人工智能应用创新大赛后端 API 文档
SWAGGER_VERSION=1.0.0

# 应用配置
APP_PORT=3001
